// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}


//      Partie Authentification

model User {
  id              Int         @id @default(autoincrement())
  full_name       String
  email           String      @unique
  password_hash   String
  refreshToken    String?     @unique
  role_id         Int?
  isLoggedIn      Boolean
  resetCode       String?
  codeExpiration  DateTime?     
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt         
  role            Role?        @relation(fields: [role_id], references: [id])
  archive   Boolean     @default(false)
  archivedAt DateTime?
}



model Role {
  id              Int         @id @default(autoincrement())
  name            String      @unique
  description     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  users           User[]
  permissions     RolePermission[]
  archive   Boolean     @default(false)
  archivedAt DateTime? 
}



model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  roles           RolePermission[]
  archive   Boolean     @default(false)
  archivedAt DateTime?
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])
  @@unique([roleId, permissionId]) 
  archive   Boolean     @default(false)
  archivedAt DateTime? 
}


//     Partie Mediatheque


model Media {
  id           Int        @id @default(autoincrement())
  file_path    String
  type         String
  alt          String?
  parameter   Parameter[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}


enum VariableType {
  COLOR
  NUMBER
  STRING
  BOOLEAN
}

model Collection {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  type        VariableType
  variables   Variable[]   
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Variable {
  id            Int        @id @default(autoincrement())
  name          String
  value         String     
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId  Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Parameter {
  id            Int      @id @default(autoincrement()) 
  entity_name   String   
  title         String   
  media         Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  mediaId       Int?    
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


model ContentType {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  slug          String         @unique
  description   String?
  fields_schema Json           
  parentId      Int?           
  parent        ContentType?   @relation("ContentTypeHierarchy", fields: [parentId], references: [id])
  children      ContentType[]  @relation("ContentTypeHierarchy")

  entries       ContentEntry[]
  taxonomies    Taxonomy[]     @relation("ContentTypeTaxonomies")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ContentEntry {
  id              Int          @id @default(autoincrement())
  contentTypeId   Int
  contentType     ContentType  @relation(fields: [contentTypeId], references: [id])
  userId          Int
  data_json       Json   
  name            String       
  status          Status       @default(DRAFT)
  taxonomies      Taxonomy[]   @relation("EntryTaxonomies")

  parentId        Int?         
  parent          ContentEntry? @relation("ContentEntryHierarchy", fields: [parentId], references: [id])
  children        ContentEntry[] @relation("ContentEntryHierarchy")

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Taxonomy {
  id              Int            @id @default(autoincrement())
  name            String
  slug            String         @unique
  description     String?
  contentTypes    ContentType[]  @relation("ContentTypeTaxonomies")
  entries         ContentEntry[] @relation("EntryTaxonomies")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}