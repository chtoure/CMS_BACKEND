// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}


//      Partie Authentification

enum StatusUser {
  ACTIVE
  EN_ATTENTE
  INACTIVE
}

model User {
  id              Int         @id @default(autoincrement())
  full_name       String
  email           String      @unique
  password_hash   String
  refreshToken    String?     @unique
  role_id         Int?
  isLoggedIn      Boolean
  resetCode       String?
  codeExpiration  DateTime?     
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt         
  role            Role?        @relation(fields: [role_id], references: [id])
  entries         ContentEntry[]
  contentTypes    ContentType[]
  taxonomies      Taxonomy[]
  archive   Boolean     @default(false)
  archivedAt DateTime?
  status StatusUser @default(EN_ATTENTE)
  confirmationToken String?
  isPendingAt DateTime? @default(now())
  isActiveAt DateTime?
}



model Role {
  id              Int         @id @default(autoincrement())
  name            String      @unique
  description     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  users           User[]
  permissions     RolePermission[]
  archive   Boolean     @default(false)
  archivedAt DateTime? 
}



model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  roles           RolePermission[]
  archive   Boolean     @default(false)
  archivedAt DateTime?
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])
  @@unique([roleId, permissionId]) 
  archive   Boolean     @default(false)
  archivedAt DateTime? 
}


//     Partie Mediatheque


model Media {
  id           Int        @id @default(autoincrement())
  file_path    String
  type         String
  alt          String?
  parameter   Parameter[]
  usedInEntries ContentEntryRelation[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}


enum VariableType {
  COLOR
  NUMBER
  STRING
  BOOLEAN
}

model Collection {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  type        VariableType
  variables   Variable[]   
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Variable {
  id            Int        @id @default(autoincrement())
  name          String
  value         String     
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId  Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Parameter {
  id            Int      @id @default(autoincrement()) 
  entity_name   String   
  title         String   
  media         Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  mediaId       Int?    
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


model ContentType {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  slug          String         @unique
  description   String?
  fields_schema Json  

  // Les ContentTypes dont je references(mes parents logiques)
  parentContentTypes  ContentTypeRelation[] @relation("TypeProprietaire")
  
  // Les ContentTypes qui me references(mes enfants logiques)
  childrenContentTypes ContentTypeRelation[] @relation("TypeCible")

  entries       ContentEntry[]
  taxonomies    Taxonomy[]     @relation("ContentTypeTaxonomies")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  archive   Boolean     @default(false)
  archivedAt DateTime? 
}






model ContentTypeRelation {
  id        Int         @id @default(autoincrement())
  
  // Celui qui possède le champ relation
  proprietaireId      Int         
  proprietaire        ContentType @relation("TypeProprietaire", fields: [proprietaireId], references: [id], onDelete: Cascade)

  // Celui qui est pointé/référencé
  cibleId             Int         
  cible               ContentType @relation("TypeCible", fields: [cibleId], references: [id], onDelete: Cascade)

  @@unique([proprietaireId, cibleId])
}





model ContentEntry {
  id              Int           @id @default(autoincrement())
  contentTypeId   Int
  contentType     ContentType   @relation(fields: [contentTypeId], references: [id])
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  data_json       Json         
  status          Status        @default(DRAFT)
  taxonomyTerms      TaxonomyTerm[]    @relation("EntryTaxonomyTerms")
  
  outgoingRelations ContentEntryRelation[] @relation("OutgoingRelations")
  incomingRelations ContentEntryRelation[] @relation("IncomingRelations")

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  archivedAt      DateTime? 
}

model ContentEntryRelation {
  id        Int      @id @default(autoincrement())
  fieldName String

  sourceId  Int
  source    ContentEntry @relation("OutgoingRelations", fields: [sourceId], references: [id], onDelete: Cascade)

  targetEntryId Int?
  targetEntry   ContentEntry? @relation("IncomingRelations", fields: [targetEntryId], references: [id], onDelete: Cascade)

  targetMediaId Int?
  targetMedia   Media?        @relation(fields: [targetMediaId], references: [id], onDelete: Cascade)

  targetTaxonomyId Int?
  targetTaxonomy   TaxonomyTerm? @relation(fields: [targetTaxonomyId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetEntryId, fieldName])
  @@unique([sourceId, targetMediaId, fieldName])
  @@unique([sourceId, targetTaxonomyId, fieldName])
  
  @@index([sourceId])
  @@index([targetEntryId])
  @@index([targetMediaId])
}

model Taxonomy {
  id              Int            @id @default(autoincrement())
  name            String
  slug            String         @unique
  description     String?
  contentTypes    ContentType[]  @relation("ContentTypeTaxonomies")
  terms       TaxonomyTerm[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  archive   Boolean     @default(false)
  archivedAt DateTime?
}


model TaxonomyTerm {
  id          Int          @id @default(autoincrement())
  name        String       // ex: "Sport"
  slug        String       @unique // ex: "sport"
  
  // La taxonomie parente
  taxonomyId  Int
  taxonomy    Taxonomy     @relation(fields: [taxonomyId], references: [id])

  contentEntryRelations ContentEntryRelation[]

  entries     ContentEntry[] @relation("EntryTaxonomyTerms")
}


enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}


model Composant {
  id               Int   @id @default(autoincrement())
  tag              String   @unique
  name             String
  icon             String
  family           String  
  supportedActions Json
  defaultProps     Json
  blocs            BlocTemplate[]
}


model BlocTemplate {
  id               Int   @id @default(autoincrement())
  composantId      Int 
  composant        Composant @relation(fields: [composantId], references: [id])
}

